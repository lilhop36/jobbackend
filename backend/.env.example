# JobHunter Ethiopia — Backend Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES. NEVER COMMIT .env!
# None of these keys are exposed to the Android APK (Section 13).

# Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# Database (PostgreSQL for production; SQLite URL file:./dev.db for local dev)
DATABASE_URL=file:./dev.db

# AI Providers (add keys for the providers you want enabled)
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=

# AI Provider Selection: groq | nvidia | mistral
AI_PRIMARY_PROVIDER=groq
AI_SECONDARY_PROVIDER=nvidia
AI_TERTIARY_PROVIDER=mistral

# AI Model Overrides (optional — defaults will be used if empty)
GROQ_INTERACTIVE_MODEL=llama-3.3-70b-versatile
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant
NVIDIA_REASONING_MODEL=meta/llama-3.3-70b-instruct
MISTRAL_LARGE_MODEL=mistral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ReliefWeb API (register your application at https://api.reliefweb.int/v2)
RELIEFWEB_APPNAME=jobhunter-ethiopia

# Background Sync
SYNC_INTERVAL_HOURS=6
JOB_EXPIRY_DAYS=60
